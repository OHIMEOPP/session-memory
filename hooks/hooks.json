{
  "description": "Session memory：SessionEnd 自動萃取本 session → 按專案分艙的向量庫；UserPromptSubmit→Stop 一隻綠色寵走「作業中→處理完成」；SessionEnd 藍色寵「萃取中→完成」",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/extract_session.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_pet.py\" --busy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_pet.py\" --done"
          }
        ]
      }
    ]
  }
}
